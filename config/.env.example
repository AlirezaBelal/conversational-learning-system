# Application mode
# Production is the default; unauthenticated development requires explicit opt-in.
ALLOW_UNAUTHENTICATED_LOCAL_WEBHOOK=false
APP_ENV=production

# Database Configuration
DB_SERVER=localhost
DB_PORT=3306
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password
DB_DATABASE=aculearn_bot_database

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Required unless explicitly testing on loopback in development. Configure the same secret when registering
# the Telegram webhook; requests without the matching header are rejected.
TELEGRAM_WEBHOOK_SECRET=

# Privacy defaults
# Raw incoming message text is not stored unless explicitly enabled.
STORE_RAW_MESSAGES=false
# Run `php scripts/purge_messages.php` on a schedule to enforce this lifecycle.
MESSAGE_RETENTION_DAYS=30

# GitHub repository renaming does not affect your Telegram BotFather username.
# Set this to the actual gateway bot handle without '@' (unrelated to the repo slug).
TELEGRAM_BOT_USERNAME=acuLearn_bot
