# Application mode
# Use production only when the webhook secret below is configured.
APP_ENV=development

# Database Configuration
DB_SERVER=localhost
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password
DB_DATABASE=aculearn_bot_database

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Required when APP_ENV=production. Configure the same secret when registering
# the Telegram webhook; requests without the matching header are rejected.
TELEGRAM_WEBHOOK_SECRET=replace_with_a_random_secret

# Privacy defaults
# Raw incoming message text is not stored unless explicitly enabled.
STORE_RAW_MESSAGES=false
# Run `php scripts/purge_messages.php` on a schedule to enforce this lifecycle.
MESSAGE_RETENTION_DAYS=30

# Optional administrator Telegram chat ID
ADMIN_CHAT_ID=your_admin_chat_id
