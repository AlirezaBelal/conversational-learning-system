# Database Configuration
DB_SERVER=localhost
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password
DB_DATABASE=aculearn_bot_database

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Optional: configure the same secret when registering the Telegram webhook.
# When set, requests without Telegram's matching secret header are rejected.
TELEGRAM_WEBHOOK_SECRET=replace_with_a_random_secret

# Optional administrator Telegram chat ID
ADMIN_CHAT_ID=your_admin_chat_id
